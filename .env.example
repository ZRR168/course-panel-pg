# ===== 后端数据库连接（Supabase PostgreSQL）=====
# 复制 Supabase 项目里 "Project Settings -> Database -> Connection string -> URI" 的
# Transaction pooler（端口 6543）或 Direct connection（端口 5432）链接，
# 把 [YOUR-PASSWORD] 换成你设置的数据库密码。
# 示例（事务池，推荐用于 Render 这类服务端）：
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ===== 前端实时同步（Supabase Realtime，使用 anon key，可公开）=====
# 复制 Supabase 项目 "Project Settings -> API" 里的：
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ===== 应用自身 =====
# 任意一串随机字符串，用于会话签名（可用 https://randomkeygen.com 生成一个）
SECRET_KEY=change-me-to-a-long-random-string
# 初始管理员密码（首次部署后可改）
ADMIN_DEFAULT_PASSWORD=ChangeMe123!
